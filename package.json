{
  "name": "harness",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "ready": "vp check && pnpm test:ci && vp run build",
    "dev": "vp run web#dev",
    "dev:website": "vp run website#dev",
    "build": "vp run --filter './apps/*' build",
    "build:web": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:ci": "node scripts/ci-tests/run.mjs",
    "test:web": "playwright test --config tests/workbench/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "catalog:",
    "@vueuse/core": "^15.0.0",
    "reactivity": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0"
}
