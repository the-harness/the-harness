{
  "compilerOptions": {
    "target": "ES2024",
    "experimentalDecorators": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "paths": {
      "/src/*": [
        "./apps/web/src/*"
      ],
      "/tests/*": [
        "./apps/web/tests/*"
      ]
    },
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "tests/**/*.ts"
  ]
}
